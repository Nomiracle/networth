# networth（净值管家）nginx 模板：Vue 静态产物 + 本机 API 反代
#
# 用法：把下面的占位符替换成实际值后，放进 nginx 的 conf.d 目录：
#   <DOMAIN>        站点域名，例如 networth.example.com
#   <WEB_ROOT>      前端 dist 的绝对路径，例如 /var/www/networth
#   <API_PORT>      后端监听端口，默认 8972
#   <CERT_PATH> / <KEY_PATH>  TLS 证书与私钥路径
# 然后：nginx -t && nginx -s reload

upstream networth_backend {
    server 127.0.0.1:<API_PORT>;
    keepalive 32;
}

server {
    listen 80;
    server_name <DOMAIN>;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name <DOMAIN>;

    ssl_certificate     <CERT_PATH>;
    ssl_certificate_key <KEY_PATH>;

    access_log /var/log/nginx/networth-access.log;
    error_log  /var/log/nginx/networth-error.log;

    root <WEB_ROOT>;
    index index.html;
    client_max_body_size 10m;

    # 注意：nginx 的 add_header 不继承 —— 任何 location 里再写 add_header，
    # 父级这几条就会丢失，所以下面两个 location 必须重复声明安全头。
    location /assets/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # 入口文件不缓存，保证发版即时生效
    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        proxy_pass http://networth_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # SPA history 模式回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}
