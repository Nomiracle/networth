# networth 后端环境变量示例：复制成 backend/.env（权限 600，不要提交）后按需修改。
# 所有项都可省略：省略时使用 backend/app/config.py 里的本地默认值。

# SQLite 路径（默认 backend/data/networth.db）
NETWORTH_DB=<PROJECT_ROOT>/backend/data/networth.db

# 服务端密钥：口令哈希的 pepper。**首次注册后不要再改**，
# 改了已有账号的密码将永久无法校验（/api/healthz 会报 secret_mismatch）。
# 生成方式：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
NETWORTH_SECRET=change-me

# 监听地址与端口（默认 127.0.0.1:8972）
NETWORTH_BIND=127.0.0.1
NETWORTH_PORT=8972

# 前端构建产物目录（默认 ../frontend/dist）
NETWORTH_WEB_DIST=<PROJECT_ROOT>/frontend/dist

# 需要重新开放注册时设为 1（首个账号创建后默认关闭）
# ALLOW_REGISTRATION=1
