# deploy/render.sh 的输入：复制成 deploy/local.env（该文件已被 gitignore，不入库）。
#
# 为什么机器相关值放在这里而不写进 unit/vhost：仓库里的模板只保留占位符，
# 真实域名、真实路径、证书路径只存在于本机；渲染产物落在 deploy/rendered/（同样不入库）。
# 后端进程自己的环境变量（NETWORTH_DB / NETWORTH_SECRET 等）不在这里，见 backend/.env.example。

# 项目根目录，模板里的 <PROJECT_ROOT> 会被替换成它
PROJECT_ROOT=/opt/networth

# 站点域名，模板里的 <DOMAIN> / __DOMAIN__
DOMAIN=networth.example.com

# 前端 dist 的绝对路径，模板里的 <WEB_ROOT>
WEB_ROOT=/var/www/networth

# 后端监听端口，模板里的 <API_PORT>
PORT=8972

# 备份目录，模板里的 <BACKUP_DIR>
BACKUP_DIR=/var/backups/networth

# nginx 的 conf.d 目录（模板注释里会用到）
# NGINX_CONF_DIR=/etc/nginx/conf.d

# TLS 证书与私钥；省略时 render.sh 按 /etc/letsencrypt/live/<DOMAIN>/ 推默认值
# CERT_PATH=/etc/letsencrypt/live/networth.example.com/fullchain.pem
# KEY_PATH=/etc/letsencrypt/live/networth.example.com/privkey.pem
